# Copy this file to .env.local and fill in the values. Never commit .env.local.
# These three are safe to show in a browser. Secret keys (Supabase secret key,
# OpenRouter, WhatsApp) live only inside n8n, never in this file.

# Supabase → Project Settings → API Keys (and Data API for the URL)
NEXT_PUBLIC_SUPABASE_URL=
# The publishable key, starts with sb_publishable_ (NOT the secret key)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The MeenuBazaar WhatsApp business number customers order on, digits only
# (country code + number, e.g. 15551234567). Filled in at Step 4.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Used ONLY by "npm run test:ai" on your Mac. Never put this on Vercel.
# The real bot gets this key inside n8n. Get it at openrouter.ai/keys
OPENROUTER_API_KEY=

# WhatsApp Phone Number ID from Meta → Step 1. Try it out (not secret). Used by npm run build:n8n
WHATSAPP_PHONE_NUMBER_ID=
